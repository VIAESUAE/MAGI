# Copy to .env for local production-like tests. For GitHub Actions, set the same in workflow env.
# Public Render API origin (no path, no trailing slash).
# VITE_API_BASE=https://your-service.onrender.com
#
# Optional: SSE idle gap (ms) while server runs slow LLM calls without sending chunks (default 600000).
# VITE_SSE_IDLE_MS=600000
# Optional: first-byte connect timeout for stream POST (default 60000).
# VITE_SSE_CONNECT_MS=60000
